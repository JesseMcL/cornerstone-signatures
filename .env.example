PORT=3000
DATABASE_PATH=/app/data/cornerstone-signatures.db

# In-process request throttling. Defaults shown; tune for your proxy topology.
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=1200
DATABASE_RATE_LIMIT_WINDOW_MS=900000
DATABASE_RATE_LIMIT_MAX_REQUESTS=10

# Reverse-proxy trust used for client-IP rate limiting. Coolify behind
# Cloudflare commonly has two proxy hops; adjust this for your topology.
# Use false if the container is reached directly with no reverse proxy.
TRUST_PROXY=2

# Browser sign-in for the picker and admin console: entra or cloudflare.
#   entra      - built-in Microsoft Entra ID sign-in (OpenID Connect). No proxy needed.
#   cloudflare - Cloudflare Access in front of the browser routes (default).
AUTH_MODE=entra

# Entra sign-in only. Encrypts the session cookie; generate with `openssl rand -base64 48`.
# Changing it signs everyone out. Sessions last SESSION_TTL_SECONDS (default 8 hours).
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_SECONDS=28800

# Cloudflare Access only.
CLOUDFLARE_TEAM_DOMAIN=example.cloudflareaccess.com
CLOUDFLARE_ACCESS_AUD=replace-with-access-application-audience
ADMIN_ALLOWED_ORIGINS=https://signatures.example.com

# Public HTTPS origin. No trailing slash.
PUBLIC_BASE_URL=https://signatures.example.com
OFFICE_ADDIN_RUNTIME_URLS=
SUPPORT_EMAIL=it@example.com
SOURCE_CODE_URL=https://github.com/example/cornerstone-signatures

# Microsoft Entra application registration.
MICROSOFT_TENANT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_CLIENT_ID=00000000-0000-0000-0000-000000000000
MICROSOFT_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
MICROSOFT_GRAPH_CLIENT_SECRET=replace-with-secret-value

# Stable Outlook add-in GUID and publisher shown in Microsoft 365.
OUTLOOK_ADDIN_ID=00000000-0000-0000-0000-000000000001
OUTLOOK_PROVIDER_NAME=Example Organization

# Emergency bootstrap administrators. Grant normal roles in the application.
INITIAL_IT_ADMINS=admin@example.com

# Development only; never set in production.
# DEV_AUTH_EMAIL=admin@example.com
